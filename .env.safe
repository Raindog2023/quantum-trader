# ==============================================================================
# R20 QUANTUM TRADER - SAFE MODE ENVIRONMENT TEMPLATE
# ==============================================================================
# SAFETY DEFAULTS: All trading disabled by default. Requires explicit override.
# ==============================================================================

# ==============================================================================
# TRADING MODE (CRITICAL SAFETY SETTING)
# ==============================================================================
# backtest    = Historical data only, no live connections (DEFAULT - SAFEST)
# paper       = Simulated trading with demo API (SAFE for testing)
# live        = REAL MONEY trading (REQUIRES explicit override + security tokens)
TRADING_MODE=backtest

# ==============================================================================
# RISK MANAGEMENT - HARD LIMITS
# ==============================================================================
# Max risk per trade as % of account (0.1 = 0.1%, 1.0 = 1%)
RISK_LIMIT_PERCENT=1.0

# Maximum position size in number of contracts/units
MAX_POSITION_SIZE=100

# Stop-loss enforcement (automatic trade close on loss %)
STOP_LOSS_PERCENT=5.0

# Profit-taking threshold
TAKE_PROFIT_PERCENT=10.0

# Daily loss limit (trading stops if exceeded)
DAILY_LOSS_LIMIT_PERCENT=3.0

# ==============================================================================
# DRY RUN & VALIDATION (SAFETY GATES)
# ==============================================================================
# DRY_RUN=1 means: simulate all trades without execution
DRY_RUN=1

# Require strategy validation before execution
STRATEGY_VALIDATION=1

# Backtest before live trading
REQUIRED_BACKTEST_DURATION_DAYS=30

# Backtest minimum Sharpe ratio (0.5 = minimum acceptable)
MIN_BACKTEST_SHARPE_RATIO=0.5

# ==============================================================================
# LLM CONFIGURATION (AI REASONING)
# ==============================================================================
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4-turbo
LLM_REASONING_EFFORT=low

# ==============================================================================
# EXCHANGE CONFIGURATION - OKX (DEMO/SAFE BY DEFAULT)
# ==============================================================================
# CRITICAL: Demo mode is default. Live credentials require explicit user action.

# Trading environment: demo (simulated) or live (real money)
R20_OKX_ENV=demo

# Demo account credentials (safe - no real money)
OKX_DEMO_API_KEY=
OKX_DEMO_SECRET_KEY=
OKX_DEMO_PASSPHRASE=

# LIVE credentials (ONLY enable if you know what you're doing)
# These must be explicitly set in secure .env.local or secrets manager
OKX_LIVE_API_KEY=
OKX_LIVE_SECRET_KEY=
OKX_LIVE_PASSPHRASE=

# Force simulated trading (safety override)
OKX_IS_SIMULATED=1

# ==============================================================================
# SECURITY & ACCESS CONTROL
# ==============================================================================
# Setup token for first-time admin login (CHANGE THIS IMMEDIATELY)
R20_SETUP_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_STRING_IMMEDIATELY

# Admin token for sensitive operations (set after first login)
R20_ADMIN_TOKEN=

# Require 2FA for admin operations
R20_REQUIRE_2FA=1

# IP whitelist for admin access (comma-separated)
R20_ADMIN_IP_WHITELIST=127.0.0.1,192.168.1.0/24

# ==============================================================================
# MANUAL TRADING CONTROLS
# ==============================================================================
# Allow manual trade closure (set to 0 to prevent accidental closes)
R20_MANUAL_CLOSE_ENABLED=0

# Require confirmation for manual orders
R20_MANUAL_ORDER_CONFIRMATION=1

# ==============================================================================
# NOTIFICATIONS & ALERTS (DISABLED BY DEFAULT)
# ==============================================================================
# Webhook notifications (for error alerts)
R20_NOTIFY_WEBHOOK_ENABLED=0
R20_NOTIFICATION_WEBHOOK=https://your-webhook-endpoint.example/r20

# Telegram alerts (for trade notifications)
R20_NOTIFY_TELEGRAM_ENABLED=0
R20_TELEGRAM_BOT_TOKEN=
R20_TELEGRAM_CHAT_ID=

# WeChat notifications
R20_NOTIFY_WECHAT_ENABLED=0
R20_WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your-key

# ==============================================================================
# AUDIT & LOGGING
# ==============================================================================
# Enable comprehensive audit logging
AUDIT_LOGGING_ENABLED=1
AUDIT_LOG_LEVEL=INFO

# Log all trades to file
TRADE_LOG_ENABLED=1
TRADE_LOG_PATH=/app/audit/trades.jsonl

# Log all API calls
API_LOG_ENABLED=1
API_LOG_PATH=/app/audit/api.jsonl

# ==============================================================================
# BACKUP & RECOVERY
# ==============================================================================
# Encryption key for backups (MUST BE SET - generate a strong random string)
R20_BACKUP_ENCRYPTION_KEY=

# Auto-backup interval (hours)
BACKUP_INTERVAL_HOURS=6

# Backup retention (days)
BACKUP_RETENTION_DAYS=90

# ==============================================================================
# DATABASE & PERSISTENCE
# ==============================================================================
# SQLite database path
DATABASE_PATH=/app/data/r20.db

# Enable database encryption
DATABASE_ENCRYPTION_ENABLED=1

# ==============================================================================
# WEB DASHBOARD
# ==============================================================================
# Dashboard host & port
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080

# Session timeout (minutes)
SESSION_TIMEOUT_MINUTES=30

# ==============================================================================
# RESOURCE LIMITS (Docker will enforce these)
# ==============================================================================
# CPU limit (cores)
# Docker limit: 2 cores
# Docker reservation: 1 core

# Memory limit
# Docker limit: 2GB
# Docker reservation: 1GB

# ==============================================================================
# MONITORING & METRICS
# ==============================================================================
# Prometheus metrics endpoint
METRICS_ENABLED=1
METRICS_PORT=9090

# Health check interval (seconds)
HEALTH_CHECK_INTERVAL=30

# ==============================================================================
# STRATEGY CONFIGURATION
# ==============================================================================
# Strategy directory
STRATEGY_PATH=/app/strategies

# Active strategies (comma-separated)
ACTIVE_STRATEGIES=

# Strategy reload interval (seconds)
STRATEGY_RELOAD_INTERVAL=300

# ==============================================================================
# PERFORMANCE TUNING
# ==============================================================================
# Worker threads for async tasks
WORKER_THREADS=4

# Max concurrent strategies
MAX_CONCURRENT_STRATEGIES=5

# Quote cache TTL (seconds)
QUOTE_CACHE_TTL=60

# ==============================================================================
# DEVELOPMENT & DEBUGGING (DISABLED IN PRODUCTION)
# ==============================================================================
# Enable debug mode
DEBUG_MODE=0

# Enable verbose logging
VERBOSE_LOGGING=0

# Print all API requests/responses
DEBUG_API_CALLS=0

# ==============================================================================
# EMERGENCY SETTINGS
# ==============================================================================
# Circuit breaker: stop all trading on critical error
CIRCUIT_BREAKER_ENABLED=1

# Max errors before circuit breaker trips
CIRCUIT_BREAKER_THRESHOLD=5

# Circuit breaker reset interval (seconds)
CIRCUIT_BREAKER_RESET_INTERVAL=3600
